---
import { getCollection } from "astro:content";
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
---

<BaseLayout
  title="Writing — Kevin Kiprotich"
  description="Writing by Kevin Kiprotich."
  bodyClass="writing-page motion-page"
  motionScript
>
  <Header active="writing" />

  <main id="main-content">
    <h1>Writing</h1>
    {
      posts.length > 0 && (
        <ol class="writing-list">
          {posts.map((post) => (
            <li>
              <a href={`/writing/${post.id}/`}>{post.data.title}</a>
              <time datetime={post.data.published.toISOString()}>
                {post.data.published.toLocaleDateString("en-AU", {
                  day: "numeric",
                  month: "long",
                  year: "numeric",
                })}
              </time>
            </li>
          ))}
        </ol>
      )
    }
  </main>
</BaseLayout>
