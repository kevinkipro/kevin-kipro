---
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import authorPhoto from "../../assets/author-github.jpg";
import FollowWriting from "../../components/FollowWriting.astro";
import EssayDiscussion from "../../components/EssayDiscussion.astro";
import Header from "../../components/Header.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("writing", ({ data }) => !data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"writing">;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} — Kevin Kiprotich`}
  description={post.data.description}
  bodyClass="essay-page motion-page"
  motionScript
>
  <Header active="writing" />

  <main id="main-content">
    <article class="essay">
      <header class="essay-header">
        <h1>{post.data.title}</h1>
        <div class="essay-byline">
          <Image src={authorPhoto} alt="" width={44} height={44}
            class="essay-author-photo" loading="eager" />
          <div class="essay-author-details">
            <a class="essay-author-name" href="https://github.com/kevinkipro" rel="author">Kevin Kiprotich</a>
            <time datetime={post.data.published.toISOString()}>
              {post.data.published.toLocaleDateString("en-AU", {
                day: "numeric",
                month: "short",
                year: "numeric",
              })}
            </time>
          </div>
        </div>
      </header>
      <div class="essay-content">
        <Content />
      </div>
    </article>
    <FollowWriting />
    <EssayDiscussion pageId={`writing:${post.id}`} title={post.data.title} />
  </main>
</BaseLayout>
