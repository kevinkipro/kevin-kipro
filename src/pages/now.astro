---
import BookShelf from "../components/BookShelf.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { now } from "../data/now";

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-AU", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<BaseLayout
  title="Now — Kevin Kiprotich"
  description="What Kevin Kiprotich is building, reading, and thinking about at the moment."
  bodyClass="now-page motion-page"
  motionScript
>
  <Header active="now" />

  <main id="main-content">
    <h1>Now</h1>

    <div class="now-lede">
      {now.lede.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <section class="entries" aria-labelledby="reading-label">
      <h2 class="section-label reading-heading" id="reading-label">Reading</h2>
      <BookShelf books={now.books} />
    </section>

    <p class="now-updated">
      Updated <time datetime={now.updated.toISOString()}>{formatDate(now.updated)}</time>
    </p>
  </main>
</BaseLayout>

<style>
  .reading-heading {
    margin-bottom: 0.5rem;
    color: var(--text);
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    text-align: center;
  }
</style>
