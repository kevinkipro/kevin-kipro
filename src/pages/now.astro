---
import { Image } from "astro:assets";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { now } from "../data/now";

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-AU", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<BaseLayout
  title="Now — Kevin Kiprotich"
  description="What Kevin Kiprotich is building, reading, and thinking about at the moment."
  bodyClass="now-page motion-page"
  motionScript
>
  <Header active="now" />

  <main id="main-content">
    <h1>Now</h1>

    <div class="now-lede">
      {now.lede.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <section class="entries" aria-labelledby="reading-label">
      <h2 class="section-label" id="reading-label">Reading</h2>
      <ul class="book-grid">
        {
          now.books.map((book) => (
            <li class="book">
              <Image
                class="book-cover"
                src={book.cover}
                alt=""
                width={300}
                loading="lazy"
              />
              <p class="book-title">{book.title}</p>
              <p class="book-meta">{book.author}</p>
              <p class:list={["book-status", { "is-reading": book.status === "Reading" }]}>
                {book.status}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="now-updated">
      Updated <time datetime={now.updated.toISOString()}>{formatDate(now.updated)}</time>
    </p>
  </main>
</BaseLayout>
