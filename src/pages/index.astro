---
import BookShelf from "../components/BookShelf.astro";
import Header from "../components/Header.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { now } from "../data/now";

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-AU", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
---

<BaseLayout
  title="Kevin Kiprotich | Software Engineering in Adelaide"
  description="Kevin Kiprotich is a software engineering degree apprentice in Adelaide, Australia. Explore his writing, current interests and work."
  bodyClass="home-page now-page"
  introScript
  motionScript
>
  <div class="intro-screen" data-intro-screen>
    <button
      class="intro-trigger"
      type="button"
      aria-label="Enter Kevin Kiprotich’s website"
      aria-controls="site-content"
      aria-expanded="false"
      data-intro-trigger
    >
      <span class="intro-wordmark" aria-hidden="true" data-intro-wordmark>
        <span data-intro-name></span><span class="intro-caret"></span>
      </span>
    </button>
  </div>

  <div class="site-shell motion-page" id="site-content" data-site-content>
    <Header active="now" />

    <main id="main-content">
      <h1>Now</h1>

      <div class="now-lede">
        {now.lede.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <section class="entries" aria-labelledby="reading-label">
        <h2 class="section-label reading-heading" id="reading-label">Reading</h2>
        <BookShelf books={now.books} />
      </section>

      <p class="now-updated">
        Updated <time datetime={now.updated.toISOString()}>{formatDate(now.updated)}</time>
      </p>
    </main>
  </div>
</BaseLayout>

<style>
  .reading-heading {
    margin-bottom: 0.5rem;
    color: var(--text);
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
    text-align: center;
  }
</style>
