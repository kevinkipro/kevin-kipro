---
import BookCoverFlow from "./BookCoverFlow.astro";
import type { Book } from "../data/now";

interface Props {
  books: Book[];
}

const { books } = Astro.props;
const shelves = [
  { id: "reading-now", label: "Reading now", books: books.filter((book) => book.status === "Reading") },
  { id: "finished", label: "Finished", books: books.filter((book) => book.status === "Finished") },
];
const initialShelf = shelves[1].books.length > 0 ? 1 : 0;
---

<book-shelf data-initial-shelf={initialShelf}>
  <div class="shelf-tabs" role="tablist" aria-label="Reading shelves" hidden>
    {shelves.map((shelf, index) => (
      <button
        id={`shelf-tab-${shelf.id}`}
        type="button"
        role="tab"
        aria-label={`${shelf.label}, ${shelf.books.length} ${shelf.books.length === 1 ? "book" : "books"}`}
        aria-controls={`shelf-panel-${shelf.id}`}
        aria-selected={index === initialShelf}
        tabindex={index === initialShelf ? 0 : -1}
      >
        {shelf.label}
      </button>
    ))}
  </div>

  {shelves.map((shelf) => (
    <div class="shelf-panel" id={`shelf-panel-${shelf.id}`}>
      <h3 class="shelf-fallback-heading section-label">{shelf.label}</h3>
      {shelf.books.length > 0
        ? <BookCoverFlow books={shelf.books} label={shelf.label} />
        : <p class="shelf-empty">{shelf.id === "reading-now" ? "Nothing on the go right now." : "No finished books yet."}</p>}
    </div>
  ))}
</book-shelf>

<script>
  class BookShelf extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      const tablist = this.querySelector<HTMLElement>(".shelf-tabs")!;
      const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>("[role=tab]"));
      const panels = Array.from(this.querySelectorAll<HTMLElement>(".shelf-panel"));

      const activate = (index: number, focus = false) => {
        tabs.forEach((tab, tabIndex) => {
          const active = tabIndex === index;
          tab.setAttribute("aria-selected", String(active));
          tab.tabIndex = active ? 0 : -1;
          panels[tabIndex].hidden = !active;
        });
        if (focus) tabs[index].focus({ preventScroll: true });
      };

      panels.forEach((panel, index) => {
        panel.setAttribute("role", "tabpanel");
        panel.setAttribute("aria-labelledby", tabs[index].id);
        panel.tabIndex = 0;
      });
      tabs.forEach((tab, index) => tab.addEventListener("click", () => activate(index)));
      tablist.addEventListener("keydown", (event) => {
        if (event.altKey || event.ctrlKey || event.metaKey) return;
        const index = tabs.indexOf(document.activeElement as HTMLButtonElement);
        if (index < 0) return;
        const next: Record<string, number> = {
          ArrowLeft: (index + tabs.length - 1) % tabs.length,
          ArrowRight: (index + 1) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        if (!(event.key in next)) return;
        event.preventDefault();
        activate(next[event.key], true);
      });

      activate(Number(this.dataset.initialShelf));
      this.dataset.ready = "true";
      tablist.hidden = false;
    }
  }

  if (!customElements.get("book-shelf")) customElements.define("book-shelf", BookShelf);
</script>

<style>
  book-shelf { display: block; }
  .shelf-tabs { display: flex; justify-content: center; gap: 1.5rem; }
  .shelf-tabs[hidden], .shelf-panel[hidden] { display: none; }
  .shelf-tabs button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: var(--secondary);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 160ms ease;
  }
  .shelf-tabs button:hover, .shelf-tabs button[aria-selected="true"] { color: var(--text); }
  .shelf-tabs button[aria-selected="true"] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .shelf-tabs button:focus-visible, .shelf-panel:focus-visible { outline: 2px solid var(--link); outline-offset: 4px; border-radius: 2px; }
  .shelf-fallback-heading { margin-top: 2rem; }
  book-shelf[data-ready] .shelf-fallback-heading { display: none; }
  .shelf-empty { min-height: 20rem; display: grid; place-items: center; margin: 0; color: var(--secondary); font-size: 0.875rem; }
  @media (prefers-reduced-motion: reduce) {
    .shelf-tabs button { transition: none; }
  }
</style>
