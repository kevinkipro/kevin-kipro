---
import { communityConfig } from "../lib/community.mjs";
const { buttondownUsername } = communityConfig(import.meta.env);
---

<section class="reader-section" aria-labelledby="follow-writing-heading">
  <h2 id="follow-writing-heading">Follow my writing</h2>
  {buttondownUsername && (
    <form class="subscribe-form" method="post"
      action={`https://buttondown.com/api/emails/embed-subscribe/${buttondownUsername}`}>
      <label class="visually-hidden" for="subscriber-email">Email address</label>
      <div class="subscribe-fields">
        <input id="subscriber-email" name="email" type="email" autocomplete="email"
          placeholder="Your email address" required />
        <input type="hidden" name="embed" value="1" />
        <button type="submit">Subscribe</button>
      </div>
    </form>
  )}
  <p class="reader-note"><a href="/rss.xml">RSS</a></p>
</section>
