---
import { communityConfig } from "../lib/community.mjs";
const { buttondownUsername } = communityConfig(import.meta.env);
---

<section class="reader-section" aria-labelledby="follow-writing-heading">
  <h2 id="follow-writing-heading">Follow my writing</h2>
  {buttondownUsername ? (
    <>
      <p>Occasional emails when I have something new to share.</p>
      <form class="subscribe-form" method="post"
        action={`https://buttondown.com/api/emails/embed-subscribe/${buttondownUsername}`}>
        <label for="subscriber-email">Email address</label>
        <div class="subscribe-fields">
          <input id="subscriber-email" name="email" type="email" autocomplete="email"
            placeholder="you@example.com" required aria-describedby="subscription-note" />
          <input type="hidden" name="embed" value="1" />
          <button type="submit">Subscribe by email</button>
        </div>
        <p class="reader-note" id="subscription-note">
          Confirm your subscription by email. Unsubscribe whenever you like.
          Signing up is separate from commenting. Email subscriptions are handled by
          <a href="https://buttondown.com/legal/privacy">Buttondown</a>.
        </p>
      </form>
      <p class="reader-note">Prefer a feed reader? <a href="/rss.xml">Subscribe via RSS</a>.</p>
    </>
  ) : (
    <p><a href="/rss.xml">Subscribe via RSS</a> to get new essays in your feed reader.</p>
  )}
</section>
