---
interface Props {
  active?: "writing" | "now" | "about";
}

const { active } = Astro.props;
---

<a class="skip-link" href="#main-content">Skip to content</a>

<header class="site-header">
  <div class="site-header-inner">
    <a class="site-name" href="/" aria-label="Kevin Kiprotich, home"><span data-site-name>Kevin Kiprotich</span></a>
    <nav aria-label="Primary navigation">
      <a href="/writing/" aria-current={active === "writing" ? "page" : undefined}>Writing</a>
      <a href="/now/" aria-current={active === "now" ? "page" : undefined}>Now</a>
      <a href="/about/" aria-current={active === "about" ? "page" : undefined}>About</a>
    </nav>
  </div>
</header>
